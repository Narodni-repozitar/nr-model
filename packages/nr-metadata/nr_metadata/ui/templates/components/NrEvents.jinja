{#def data #}
{% if data %}
<dl class='detail-subfields ui list'>
    {% for event in data %}
    <div class="item">
        <div class="content">
            <SeparatedProperty isLast={True} label={_('metadata/events/eventNameOriginal.label')}>
                {{ event.eventNameOriginal }}
            </SeparatedProperty>
            <br/>
            {% if event.eventNameAlternate %}
                <SeparatedProperty isLast={True} label={_('metadata/events/eventNameAlternate.label')}>
                    {% for name in event.eventNameAlternate %}
                        {{ name }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </SeparatedProperty>
                <br/>
            {% endif %}
            <SeparatedProperty isLast={True} label={_('metadata/events/eventLocation/place.label')}>
                {{ event.eventLocation.place }}
            </SeparatedProperty>
            <br/>
            <SeparatedProperty isLast={True} label={_('metadata/events/eventLocation/country.label')}>
                {{ event.eventLocation.country.title }}
            </SeparatedProperty>
            <br/>
            <SeparatedProperty isLast={True} label={_('metadata/events/eventDate.label')}>
               {{ event.eventDate }}
            </SeparatedProperty>
        </div>
        {% if not loop.last %}
            <div class="rel-mb-1"></div>
        {% endif %}
    </div>
    {% endfor %}
</dl>
{% endif %}
